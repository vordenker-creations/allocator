# =============================================================================
# VKU's Allocator — Environment Configuration
# Copy to .env and fill in your Proxmox VE API Token for live bare-metal telemetry
# =============================================================================

# Host Port Mapping (8090 avoids colliding with services on 8080)
APP_PORT=8090
DB_HOST_PORT=3306

# Database Connection (Docker Compose defaults)
DB_HOST=db
DB_PORT=3306
DB_NAME=vku_allocator
DB_USER=vku_user
DB_PASS=vku_password

# Public SSH Gateway Hostname & Browser Terminal URL shown in Console Receipts
ALLOCATOR_PUBLIC_HOST=allocator.vordenker.work
ALLOCATOR_SHELL_URL=https://shell.vordenker.work

# Path 2: Live Proxmox VE Hypervisor Telemetry (vor-server)
PROXMOX_HOST=https://192.168.1.200:8006
PROXMOX_NODE=vor-server
# Format: user@realm!tokenid (e.g. root@pam!allocator)
PROXMOX_TOKEN_ID=
# UUID secret generated in Proxmox Datacenter -> Permissions -> API Tokens
PROXMOX_TOKEN_SECRET=

# Proxmox Guest Lifecycle Control (when vor-server is leased)
# Target guest VMID/CTID to start/stop on lease transitions (must differ from PROXMOX_HOST_VMID)
PROXMOX_LEASE_VMID=200
# Guest virtualisation type: 'lxc' (Linux Container) or 'qemu' (KVM Virtual Machine)
PROXMOX_LEASE_GUEST_TYPE=lxc
# Protected host VMID running Allocator itself (strictly blocked from lifecycle actions)
PROXMOX_HOST_VMID=100
# Optional LVM-Thin / ZFS snapshot name to roll back to on lease start/end (e.g. 'clean')
PROXMOX_CLEAN_SNAPSHOT=clean
